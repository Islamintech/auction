<%- include('includes/header') %>
<%- include('includes/nav', { page: 'consultations' }) %>

<body>
<main>
  <div class="page">

    <div class="page-head">
      <div>
        <h1 class="page-title">Consultations</h1>
        <p class="page-sub">Buyer requests and follow-ups</p>
      </div>
      <div class="metrics">
        <div>
          <span class="metric-label">Total</span>
          <span class="metric-value num"><%= consultations.length %></span>
        </div>
        <div>
          <span class="metric-label">Pending</span>
          <span class="metric-value metric-value--accent num">
            <%= consultations.filter(c => c.status === 'PENDING').length %>
          </span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <div class="flex flex-wrap items-center gap-2">
          <button onclick="filterByStatus('all')"         id="filter-all"         class="pill active">All</button>
          <button onclick="filterByStatus('PENDING')"     id="filter-PENDING"     class="pill">Pending</button>
          <button onclick="filterByStatus('IN_PROGRESS')" id="filter-IN_PROGRESS" class="pill">In progress</button>
          <button onclick="filterByStatus('RESOLVED')"    id="filter-RESOLVED"    class="pill">Resolved</button>
          <button onclick="filterByStatus('CANCELLED')"   id="filter-CANCELLED"   class="pill">Cancelled</button>
        </div>
        <input id="search-input" oninput="applyFilters()" type="text" class="search" placeholder="Search by name" />
      </div>

      <div class="tbl-wrap scrollbar-hide">
        <table class="tbl">
          <thead>
            <tr>
              <th class="t-idx">#</th>
              <th>Car</th>
              <th>Customer</th>
              <th>Channel</th>
              <th>Message</th>
              <th>Status</th>
              <th>Date</th>
              <th class="t-right">Actions</th>
            </tr>
          </thead>
          <tbody id="consultations-tbody">
            <% consultations.map(function(c, i) { %>
            <tr class="consultation-row"
              data-name="<%= c.name?.toLowerCase() %>"
              data-status="<%= c.status %>">
              <td data-label="#" class="t-idx num"><%= i + 1 %></td>
              <td data-label="Car">
                <div class="flex items-center gap-3">
                  <div class="thumb w-10 h-10">
                    <% if (c.carId?.carImages?.length) { %>
                      <img src="<%= imgUrl(c.carId.carImages[0]) %>" alt="" />
                    <% } else { %>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 17H3v-5l2-5h14l2 5v5h-2"/><circle cx="7.5" cy="17" r="2"/><circle cx="16.5" cy="17" r="2"/></svg>
                    <% } %>
                  </div>
                  <div class="t-primary truncate max-w-[160px]"><%= c.carId?.carTitle || '—' %></div>
                </div>
              </td>
              <td data-label="Customer">
                <div class="t-primary"><%= c.name %></div>
                <div class="t-secondary num"><%= c.phone %></div>
              </td>
              <td data-label="Channel">
                <span class="tag <%= c.preferredContact === 'TELEGRAM' ? 'tag-blue' :
                                     c.preferredContact === 'WHATSAPP' ? 'tag-green' :
                                     c.preferredContact === 'CALL'     ? 'tag-green' : 'tag-amber' %>">
                  <span class="dot"></span>
                  <%= c.preferredContact ? c.preferredContact.charAt(0) + c.preferredContact.slice(1).toLowerCase() : '—' %>
                </span>
              </td>
              <td data-label="Message">
                <p class="truncate max-w-[220px]" style="font-size:13px; color:rgb(var(--text-muted))"><%= c.message || '—' %></p>
              </td>
              <td data-label="Status">
                <select id="<%= c._id %>" onchange="updateStatus(this)"
                  class="status-select <%= c.status === 'PENDING'     ? 's-amber' :
                                           c.status === 'IN_PROGRESS' ? 's-blue'  :
                                           c.status === 'RESOLVED'    ? 's-green' : 's-red' %>">
                  <option value="PENDING"     <%= c.status === 'PENDING'     ? 'selected' : '' %>>Pending</option>
                  <option value="IN_PROGRESS" <%= c.status === 'IN_PROGRESS' ? 'selected' : '' %>>In progress</option>
                  <option value="RESOLVED"    <%= c.status === 'RESOLVED'    ? 'selected' : '' %>>Resolved</option>
                  <option value="CANCELLED"   <%= c.status === 'CANCELLED'   ? 'selected' : '' %>>Cancelled</option>
                </select>
              </td>
              <td data-label="Date" style="color:rgb(var(--text-muted)); font-size:13px">
                <%= new Date(c.createdAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </td>
              <td data-label="Actions" class="t-right">
                <div class="row-actions">
                  <button onclick="deleteConsultation('<%= c._id %>')" class="icon-btn is-danger" title="Delete" aria-label="Delete">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                  </button>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if(consultations.length === 0) { %>
            <tr><td colspan="8" class="t-empty">No consultation requests yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="card-foot"><span><%= consultations.length %> total</span></div>
    </div>

  </div>
</main>

<script>
let activeStatus = 'all';

function filterByStatus(status) {
    activeStatus = status;
    document.querySelectorAll('.pill').forEach(btn => btn.classList.remove('active'));
    document.getElementById('filter-' + status)?.classList.add('active');
    applyFilters();
}

function applyFilters() {
    const query = document.getElementById('search-input').value.toLowerCase();
    document.querySelectorAll('.consultation-row').forEach(row => {
        const name   = row.dataset.name   || '';
        const status = row.dataset.status || '';
        const matchesSearch = name.includes(query);
        const matchesStatus = activeStatus === 'all' || status === activeStatus;
        row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
    });
}

function deleteConsultation(id) {
    if (!confirm('Delete this consultation request?')) return;
    fetch(`/admin/consultation/${id}/delete`, { method: 'POST' })
        .then(r => r.ok ? window.location.reload() : Promise.reject(r))
        .catch(() => alert('Failed to delete'));
}

function updateStatus(select) {
    const id     = select.id;
    const status = select.value;

    select.classList.remove('s-amber', 's-blue', 's-green', 's-red');
    select.classList.add(
        status === 'PENDING'     ? 's-amber' :
        status === 'IN_PROGRESS' ? 's-blue'  :
        status === 'RESOLVED'    ? 's-green' : 's-red'
    );
    select.closest('tr').dataset.status = status;

    fetch(`/admin/consultation/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
    })
    .catch(() => alert('Failed to update status'));
}
</script>

</body>
<%- include('includes/footer') %>
