<%- include('includes/header') %>
<%- include('includes/nav', { page: 'posts' }) %>

<body>
<main>
  <div class="page">

    <div class="page-head">
      <div>
        <h1 class="page-title">Posts</h1>
        <p class="page-sub">News, articles and community content</p>
      </div>
      <div class="metrics">
        <div>
          <span class="metric-label">Total</span>
          <span class="metric-value num"><%= posts.length %></span>
        </div>
        <div>
          <span class="metric-label">Published</span>
          <span class="metric-value metric-value--green num">
            <%= posts.filter(p => p.postStatus === 'ACTIVE').length %>
          </span>
        </div>
      </div>
    </div>

    <div class="stack">

      <!-- ---------- Create a post ---------- -->
      <div class="card">
        <details>
          <summary>
            <div class="flex items-center gap-3">
              <span class="summary-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
              <div>
                <h3 class="card-title">Create a post</h3>
                <p class="hint">Publish news, an article, or a free-board entry</p>
              </div>
            </div>
            <svg class="summary-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>

          <div class="card-body">
            <form action="/admin/post/create" method="POST" enctype="multipart/form-data" class="flex flex-col gap-5">

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="field sm:col-span-2">
                  <label for="new-post-title">Title *</label>
                  <input id="new-post-title" name="postTitle" type="text" required class="input"
                         placeholder="New arrivals from Korea this week" />
                </div>
                <div class="field">
                  <label for="new-post-type">Type *</label>
                  <select id="new-post-type" name="postType" required class="select">
                    <option value="">Select type</option>
                    <option value="NEWS">News</option>
                    <option value="ARTICLE">Article</option>
                    <option value="FREE_BOARD">Free board</option>
                  </select>
                </div>
              </div>

              <div class="field">
                <label for="new-post-body">Body *</label>
                <textarea id="new-post-body" name="postBody" rows="6" required class="textarea"
                          placeholder="Write your post content here..."></textarea>
              </div>

              <div class="field">
                <label>Cover image <span class="label-hint">— optional</span></label>
                <div class="dropzone flex-row gap-4 p-4" style="align-items:center; justify-content:flex-start">
                  <div class="thumb w-16 h-16" style="position:relative; overflow:hidden">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" id="post-img-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    <img id="post-img-preview" style="display:none" alt="" />
                  </div>
                  <div style="text-align:left">
                    <p style="font-size:13px; color:rgb(var(--text-muted))">Click to upload a cover image</p>
                    <p class="hint">JPG, PNG or WEBP · max 5 MB</p>
                  </div>
                  <input type="file" name="postImage" accept="image/*" onchange="previewPostImage(this)" />
                </div>
              </div>

              <div class="form-actions">
                <button type="button" onclick="this.closest('details').removeAttribute('open')" class="btn btn-ghost">Discard</button>
                <button type="submit" class="btn btn-primary">Publish post</button>
              </div>
            </form>
          </div>
        </details>
      </div>

      <!-- ---------- All posts ---------- -->
      <div class="card">
        <div class="card-head">
          <div class="flex flex-wrap items-center gap-2">
            <button onclick="filterByType('all')"        id="filter-all"        class="pill active">All</button>
            <button onclick="filterByType('news')"       id="filter-news"       class="pill">News</button>
            <button onclick="filterByType('article')"    id="filter-article"    class="pill">Article</button>
            <button onclick="filterByType('free_board')" id="filter-free_board" class="pill">Free board</button>
          </div>
          <input id="search-input" oninput="applyFilters()" type="text" class="search" placeholder="Search title" />
        </div>

        <div class="tbl-wrap scrollbar-hide">
          <table class="tbl">
            <thead>
              <tr>
                <th class="t-idx">#</th>
                <th>Title</th>
                <th>Type</th>
                <th>Visibility</th>
                <th>Views</th>
                <th>Engagement</th>
                <th>Date</th>
                <th class="t-right">Actions</th>
              </tr>
            </thead>
            <tbody id="posts-tbody">
              <% posts.map(function(p, i) { %>
              <tr class="post-row"
                data-title="<%= p.postTitle?.toLowerCase() %>"
                data-type="<%= p.postType?.toLowerCase() %>">
                <td data-label="#" class="t-idx num"><%= i + 1 %></td>
                <td data-label="Title">
                  <div class="flex items-center gap-3">
                    <div class="thumb w-10 h-10">
                      <% if(p.postImage) { %>
                        <img src="<%= imgUrl(p.postImage) %>" alt="" />
                      <% } else { %>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                      <% } %>
                    </div>
                    <div class="t-primary truncate max-w-[280px]"><%= p.postTitle %></div>
                  </div>
                </td>
                <td data-label="Type">
                  <span class="tag <%= p.postType === 'ARTICLE' ? 'tag-green' : p.postType === 'NEWS' ? 'tag-amber' : 'tag-neutral' %>">
                    <%= p.postType === 'FREE_BOARD' ? 'Free board' : p.postType ? p.postType.charAt(0) + p.postType.slice(1).toLowerCase() : '—' %>
                  </span>
                </td>
                <td data-label="Visibility">
                  <% if (p.postStatus === 'ACTIVE') { %>
                    <button onclick="setPostVisibility('<%= p._id %>', 'DRAFT')" class="tag tag-green"
                            style="border:0; cursor:pointer" title="Published — click to unpublish">
                      <span class="dot"></span> Public
                    </button>
                  <% } else if (p.postStatus === 'DELETE') { %>
                    <span class="tag tag-red">Deleted</span>
                  <% } else { %>
                    <button onclick="setPostVisibility('<%= p._id %>', 'ACTIVE')" class="tag tag-neutral"
                            style="border:0; cursor:pointer" title="Draft — click to publish">
                      Draft
                    </button>
                  <% } %>
                </td>
                <td data-label="Views" class="num" style="font-size:13px"><%= p.postViewCount?.toLocaleString() || 0 %></td>
                <td data-label="Engagement">
                  <span class="t-secondary num" style="margin-top:0">
                    <%= p.postLikeCount || 0 %> likes · <%= p.postCommentCount || 0 %> comments
                  </span>
                </td>
                <td data-label="Date" style="color:rgb(var(--text-muted)); font-size:13px">
                  <%= new Date(p.createdAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <td data-label="Actions" class="t-right">
                  <div class="row-actions">
                    <button onclick='openEditPost(<%- JSON.stringify({ _id: p._id, postTitle: p.postTitle, postBody: p.postBody, postType: p.postType, postStatus: p.postStatus }) %>)'
                            class="icon-btn" title="Edit" aria-label="Edit">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    </button>
                    <button onclick="deletePost('<%= p._id %>')" class="icon-btn is-danger" title="Delete" aria-label="Delete">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% if(posts.length === 0) { %>
              <tr><td colspan="8" class="t-empty">No posts yet. Create your first one above.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="card-foot"><span><%= posts.length %> total</span></div>
      </div>

    </div>
  </div>
</main>

<!-- ---------- Edit post ---------- -->
<div id="edit-post-modal" class="modal" hidden>
  <div class="modal-scrim" onclick="closeEditPost()"></div>
  <div class="modal-panel max-w-2xl">
    <div class="modal-head">
      <h3 class="card-title">Edit post</h3>
      <button type="button" onclick="closeEditPost()" class="icon-btn is-danger" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="edit-post-form" enctype="multipart/form-data" class="modal-body flex flex-col gap-5">
      <input type="hidden" name="_id" id="edit-post-id" />

      <div class="field">
        <label for="edit-post-title">Title</label>
        <input name="postTitle" id="edit-post-title" type="text" class="input" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="field">
          <label for="edit-post-type">Type</label>
          <select name="postType" id="edit-post-type" class="select">
            <option value="NEWS">News</option>
            <option value="ARTICLE">Article</option>
            <option value="FREE_BOARD">Free board</option>
          </select>
        </div>
        <div class="field">
          <label for="edit-post-status">Status</label>
          <select name="postStatus" id="edit-post-status" class="select">
            <option value="DRAFT">Draft — hidden from the public site</option>
            <option value="ACTIVE">Published — visible to everyone</option>
            <option value="DELETE">Deleted</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="edit-post-body">Body</label>
        <textarea name="postBody" id="edit-post-body" rows="6" class="textarea"></textarea>
      </div>

      <div class="field">
        <label for="edit-post-image">Replace cover image <span class="label-hint">— optional</span></label>
        <input id="edit-post-image" type="file" name="postImage" accept="image/*" class="input" style="padding:7px 10px" />
      </div>

      <div class="form-actions">
        <button type="button" onclick="closeEditPost()" class="btn btn-ghost">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </div>
</div>

<script>
let activeType = 'all';

function filterByType(type) {
    activeType = type;
    document.querySelectorAll('.pill').forEach(btn => btn.classList.remove('active'));
    document.getElementById('filter-' + type)?.classList.add('active');
    applyFilters();
}

function applyFilters() {
    const query = document.getElementById('search-input').value.toLowerCase();
    document.querySelectorAll('.post-row').forEach(row => {
        const title = row.dataset.title || '';
        const type  = row.dataset.type  || '';
        const matchesSearch = title.includes(query);
        const matchesType   = activeType === 'all' || type === activeType;
        row.style.display = (matchesSearch && matchesType) ? '' : 'none';
    });
}

function previewPostImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = (e) => {
            const preview = document.getElementById('post-img-preview');
            const icon    = document.getElementById('post-img-icon');
            preview.src = e.target.result;
            preview.style.display = 'block';
            preview.style.position = 'absolute';
            preview.style.inset = '0';
            preview.style.width = '100%';
            preview.style.height = '100%';
            preview.style.objectFit = 'cover';
            icon.style.display = 'none';
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function openEditPost(post) {
    document.getElementById('edit-post-id').value     = post._id;
    document.getElementById('edit-post-title').value  = post.postTitle  || '';
    document.getElementById('edit-post-body').value   = post.postBody   || '';
    document.getElementById('edit-post-type').value   = post.postType   || 'NEWS';
    document.getElementById('edit-post-status').value = post.postStatus || 'DRAFT';
    document.getElementById('edit-post-modal').hidden = false;
}

function closeEditPost() {
    document.getElementById('edit-post-modal').hidden = true;
    document.getElementById('edit-post-form').reset();
}

document.getElementById('edit-post-form').addEventListener('submit', function (e) {
    e.preventDefault();
    const form = e.target;
    const id   = document.getElementById('edit-post-id').value;
    const fd   = new FormData(form);

    // strip empty file field so it doesn't overwrite the existing image
    const file = fd.get('postImage');
    if (file && file.size === 0) fd.delete('postImage');

    fetch(`/admin/post/${id}`, { method: 'POST', body: fd })
        .then(r => r.ok ? window.location.reload() : Promise.reject(r))
        .catch(() => alert('Failed to update post'));
});

// One-click publish / unpublish from the Visibility column. The update route
// runs through multer (the edit form posts multipart), so send FormData rather
// than JSON — a JSON body would arrive empty.
function setPostVisibility(id, status) {
    if (status === 'DRAFT' && !confirm('Unpublish this post? It will disappear from the public site.')) return;

    const fd = new FormData();
    fd.append('postStatus', status);

    fetch(`/admin/post/${id}`, { method: 'POST', body: fd })
        .then(async (r) => {
            if (!r.ok) {
                let msg = 'Failed to change visibility';
                try { const b = await r.json(); if (b && b.message) msg = b.message; } catch (e) {}
                throw new Error(msg);
            }
            window.location.reload();
        })
        .catch((err) => alert(err.message || 'Failed to change visibility'));
}

function deletePost(id) {
    if (!confirm('Delete this post?')) return;
    fetch(`/admin/post/${id}/delete`, { method: 'POST' })
        .then(async (r) => {
            if (!r.ok) {
                let msg = 'Failed to delete';
                try { const b = await r.json(); if (b && b.message) msg = b.message; } catch (e) {}
                throw new Error(msg);
            }
            window.location.reload();
        })
        .catch((err) => alert(err.message || 'Failed to delete'));
}
</script>

</body>
<%- include('includes/footer') %>
