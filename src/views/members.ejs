<%- include('includes/header') %>
<%- include('includes/nav', { page: 'members' }) %>

<body>
<main>
  <div class="page">

    <div class="page-head">
      <div>
        <h1 class="page-title">Members</h1>
        <p class="page-sub">Registered accounts and access</p>
      </div>
      <input id="search-input" oninput="filterMembers()" type="text" class="search"
             placeholder="Search name or phone" />
    </div>

    <div class="stack">

      <div class="stat-grid">
        <div class="stat">
          <div class="stat-label">Active</div>
          <div class="stat-value num" id="count-active" style="color:rgb(var(--green))">0</div>
          <div class="stat-sub">Accounts in good standing</div>
        </div>
        <div class="stat">
          <div class="stat-label">Banned</div>
          <div class="stat-value num" id="count-banned" style="color:rgb(var(--amber))">0</div>
          <div class="stat-sub">Access restricted</div>
        </div>
        <div class="stat">
          <div class="stat-label">Deleted</div>
          <div class="stat-value num" id="count-deleted" style="color:rgb(var(--red))">0</div>
          <div class="stat-sub">Archived profiles</div>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3 class="card-title">All members</h3>
        </div>

        <div class="tbl-wrap scrollbar-hide">
          <table class="tbl">
            <thead>
              <tr>
                <th class="t-idx">#</th>
                <th>Member</th>
                <th>Contact</th>
                <th>Points</th>
                <th>Joined</th>
                <th>Status</th>
                <th class="t-right">Actions</th>
              </tr>
            </thead>
            <tbody id="members-tbody">
              <% members.map(function(m, index) { %>
              <tr class="member-row"
                data-nick="<%= m.memberNick?.toLowerCase() %>"
                data-phone="<%= m.memberPhone %>"
                data-status="<%= m.memberStatus %>">
                <td data-label="#" class="t-idx num"><%= index + 1 %></td>
                <td data-label="Member">
                  <div class="flex items-center gap-3">
                    <div class="avatar w-10 h-10">
                      <% if(m.memberImage) { %>
                        <img src="<%= imgUrl(m.memberImage) %>" alt="" />
                      <% } else { %>
                        <%= m.memberNick?.charAt(0).toUpperCase() %>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <div class="t-primary truncate"><%= m.memberNick %></div>
                      <div class="t-secondary"><%= m.memberCountry || 'Unknown' %></div>
                    </div>
                  </div>
                </td>
                <td data-label="Contact">
                  <div class="num" style="font-size:13px"><%= m.memberPhone %></div>
                  <div class="t-secondary"><%= m.memberEmail || '—' %></div>
                </td>
                <td data-label="Points">
                  <span class="num" style="font-weight:600"><%= m.memberPoints?.toLocaleString() || 0 %></span>
                  <span class="t-secondary" style="display:inline; margin-left:3px">pts</span>
                </td>
                <td data-label="Joined" style="color:rgb(var(--text-muted)); font-size:13px">
                  <%= new Date(m.createdAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <td data-label="Status">
                  <select id="<%= m._id %>" onchange="updateMemberStatus(this)"
                    class="status-select <%= m.memberStatus === 'ACTIVE' ? 's-green' : m.memberStatus === 'BANNED' ? 's-amber' : 's-red' %>">
                    <option value="ACTIVE" <%= m.memberStatus === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                    <option value="BANNED" <%= m.memberStatus === 'BANNED' ? 'selected' : '' %>>Banned</option>
                    <option value="DELETE" <%= m.memberStatus === 'DELETE' ? 'selected' : '' %>>Deleted</option>
                  </select>
                </td>
                <td data-label="Actions" class="t-right">
                  <div class="row-actions">
                    <button onclick="viewMember('<%= m._id %>')" class="icon-btn" title="View details" aria-label="View details">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% if(members.length === 0) { %>
              <tr><td colspan="7" class="t-empty">No members yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="card-foot"><span><%= members.length %> total</span></div>
      </div>

    </div>
  </div>
</main>

<script>
// The three tiles are derived from the rows, so they can be recounted in place
// after a status change instead of needing a page reload.
function recount() {
    let active = 0, banned = 0, deleted = 0;
    document.querySelectorAll('.member-row').forEach(row => {
        const status = row.dataset.status;
        if (status === 'ACTIVE') active++;
        else if (status === 'BANNED') banned++;
        else if (status === 'DELETE') deleted++;
    });
    document.getElementById('count-active').textContent  = active;
    document.getElementById('count-banned').textContent  = banned;
    document.getElementById('count-deleted').textContent = deleted;
}
document.addEventListener('DOMContentLoaded', recount);

function filterMembers() {
    const query = document.getElementById('search-input').value.toLowerCase();
    document.querySelectorAll('.member-row').forEach(row => {
        const nick  = row.dataset.nick  || '';
        const phone = row.dataset.phone || '';
        row.style.display = (nick.includes(query) || phone.includes(query)) ? '' : 'none';
    });
}

function updateMemberStatus(select) {
    const memberId     = select.id;
    const memberStatus = select.value;

    select.classList.remove('s-green', 's-amber', 's-red');
    select.classList.add(
        memberStatus === 'ACTIVE' ? 's-green' : memberStatus === 'BANNED' ? 's-amber' : 's-red'
    );
    select.closest('tr').dataset.status = memberStatus;
    recount();

    fetch('/admin/member/edit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ _id: memberId, memberStatus }),
    })
    .then(res => res.json())
    .catch(() => alert('Failed to update status'));
}

function viewMember(id) {
    alert(`Member ID: ${id}`);
}
</script>

</body>
<%- include('includes/footer') %>
