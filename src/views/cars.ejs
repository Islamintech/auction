<%- include('includes/header') %>
<%- include('includes/nav', { page: 'cars' }) %>

<body>
<main>
  <div class="page">

    <div class="page-head">
      <div>
        <h1 class="page-title">Cars</h1>
        <p class="page-sub">Inventory and listing control</p>
      </div>
      <div class="metrics">
        <div>
          <span class="metric-label">Total units</span>
          <span class="metric-value num"><%= cars.length %></span>
        </div>
        <div>
          <span class="metric-label">On sale</span>
          <span class="metric-value metric-value--green num"><%= cars.filter(c => c.carStatus === 'ONSALE').length %></span>
        </div>
      </div>
    </div>

    <div class="stack">

      <!-- ---------- Add a car ---------- -->
      <div class="card">
        <details>
          <summary>
            <div class="flex items-center gap-3">
              <span class="summary-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
              <div>
                <h3 class="card-title">Add a car</h3>
                <p class="hint">Create a new marketplace listing</p>
              </div>
            </div>
            <svg class="summary-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>

          <div class="card-body">
            <form action="/admin/car/create" method="POST" enctype="multipart/form-data"
                  onsubmit="return validateCarForm()" class="grid grid-cols-12 gap-6">
              <input name="carStatus" value="ONSALE" hidden />

              <div class="col-span-12 lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-5">

                <div class="field sm:col-span-2">
                  <label for="new-title">Listing title *</label>
                  <input id="new-title" name="carTitle" type="text" required class="input"
                         placeholder="2024 Hyundai Sonata Premium" />
                </div>

                <div class="field sm:col-span-2">
                  <label for="new-vin">VIN</label>
                  <input id="new-vin" name="carVin" type="text" maxlength="17" class="input input-mono uppercase"
                         placeholder="1HGCM82633A004352" />
                </div>

                <div class="field">
                  <label for="new-brand">Brand *</label>
                  <input id="new-brand" name="carBrand" type="text" required list="brand-options"
                         autocomplete="off" class="input" placeholder="Hyundai" />
                </div>

                <div class="field">
                  <label for="new-model">Model</label>
                  <input id="new-model" name="carModel" type="text" class="input" placeholder="Sonata" />
                </div>

                <div class="field">
                  <label for="new-type">Body type *</label>
                  <select id="new-type" name="carType" required class="select">
                    <option value="">Select type</option>
                    <% CarType.map(function(t) { %>
                      <option value="<%= t %>"><%= t.charAt(0) + t.slice(1).toLowerCase() %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field">
                  <label for="carCondition">Condition *</label>
                  <select id="carCondition" name="carCondition" required class="select">
                    <% CarCondition.map(function(c) { %>
                      <option value="<%= c %>"><%= c.charAt(0) + c.slice(1).toLowerCase() %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field">
                  <label for="new-year">Model year *</label>
                  <input id="new-year" name="carYear" type="text" required class="input input-mono"
                         placeholder="2024 or 2025/12" />
                </div>

                <div class="field">
                  <label for="new-mileage">Mileage (km) *</label>
                  <input id="new-mileage" name="carMileage" type="number" required min="0"
                         class="input input-mono" placeholder="0" />
                </div>

                <div class="field">
                  <label for="new-price">Valuation (KRW) *</label>
                  <input id="new-price" name="carPrice" type="text" required data-usd-estimate-source
                         class="input input-mono" placeholder="18,000,000 or 18,000,000~22,000,000" />
                  <p data-usd-estimate class="hint">Estimated USD: enter a KRW price</p>
                </div>

                <div class="field">
                  <label for="new-color">Colour</label>
                  <input id="new-color" name="carColor" type="text" list="color-options"
                         autocomplete="off" class="input" placeholder="White" />
                </div>

                <div class="field">
                  <label for="new-fuel">Fuel</label>
                  <select id="new-fuel" name="carFuel" class="select">
                    <% CarFuel.map(function(f) { %>
                      <option value="<%= f %>"><%= f.charAt(0) + f.slice(1).toLowerCase() %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field">
                  <label for="new-trans">Transmission</label>
                  <select id="new-trans" name="carTransmission" class="select">
                    <% CarTransmission.map(function(t) { %>
                      <option value="<%= t %>"><%= t.charAt(0) + t.slice(1).toLowerCase() %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="field sm:col-span-2">
                  <label for="new-desc">Description and notes</label>
                  <textarea id="new-desc" name="carDesc" rows="3" class="textarea"
                            placeholder="Technical specs, condition report, additional notes..."></textarea>
                </div>

              </div>

              <div class="col-span-12 lg:col-span-4">
                <div class="field">
                  <label>Gallery <span class="label-hint">— up to 10</span></label>
                  <div class="dropzone h-40 sm:h-44">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" id="cover-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    <span style="font-size:12px">Cover photo</span>
                    <img id="preview-1" style="display:none" alt="" />
                    <input type="file" name="carImages" accept="image/*" required onchange="previewImage(this,1)" />
                  </div>
                  <div class="grid grid-cols-5 gap-2 mt-2">
                    <% for(var i = 2; i <= 10; i++) { %>
                    <div class="dropzone aspect-square">
                      <span id="icon-<%= i %>" style="font-size:15px">+</span>
                      <img id="preview-<%= i %>" style="display:none" alt="" />
                      <input type="file" name="carImages" accept="image/*" data-index="<%= i %>" class="secondary-file-input" />
                    </div>
                    <% } %>
                  </div>
                  <p class="hint mt-2">JPG, PNG or WEBP · max 5 MB each</p>
                </div>
              </div>

              <div class="col-span-12 form-actions">
                <button type="button" id="discard-btn" class="btn btn-ghost">Discard</button>
                <button type="submit" class="btn btn-primary">Save listing</button>
              </div>

            </form>
          </div>
        </details>
      </div>

      <!-- ---------- Inventory ---------- -->
      <div class="card">
        <div class="card-head">
          <h3 class="card-title">Inventory</h3>
          <input type="text" id="search-input" oninput="filterCars()" class="search"
                 placeholder="Search model or brand" />
        </div>

        <div class="tbl-wrap scrollbar-hide">
          <table class="tbl">
            <thead>
              <tr>
                <th class="t-idx">#</th>
                <th>Vehicle</th>
                <th>Brand</th>
                <th>Specs</th>
                <th>Price</th>
                <th>Stats</th>
                <th>Status</th>
                <th class="t-right">Actions</th>
              </tr>
            </thead>
            <tbody id="cars-tbody">
              <% cars.map(function(car, key) { %>
              <tr class="car-row"
                data-title="<%= car.carTitle?.toLowerCase() %>"
                data-brand="<%= car.carBrand?.toLowerCase() %>"
                data-car="<%= encodeURIComponent(JSON.stringify(car)) %>">
                <td data-label="#" class="t-idx num"><%= key + 1 %></td>
                <td data-label="Vehicle">
                  <div class="flex items-center gap-3">
                    <div class="thumb w-11 h-11">
                      <% if(car.carImages && car.carImages.length > 0) { %>
                        <img src="<%= imgUrl(car.carImages[0]) %>" alt="" />
                      <% } else { %>
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 17H3v-5l2-5h14l2 5v5h-2"/><circle cx="7.5" cy="17" r="2"/><circle cx="16.5" cy="17" r="2"/></svg>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <div class="t-primary truncate"><%= car.carTitle %></div>
                      <% if (car.carColor) { %><div class="t-secondary"><%= car.carColor %></div><% } %>
                    </div>
                  </div>
                </td>
                <td data-label="Brand"><span class="tag tag-neutral"><%= car.carBrand %></span></td>
                <td data-label="Specs">
                  <div style="font-size:13.5px">
                    <span class="num"><%= car.carYear %></span>
                    <span style="color:rgb(var(--text-faint))">·</span>
                    <span class="num"><%= car.carMileage === 0 ? 'New' : car.carMileage?.toLocaleString() + ' km' %></span>
                  </div>
                  <div class="t-secondary">
                    <%= car.carType ? car.carType.charAt(0) + car.carType.slice(1).toLowerCase() : '—' %>
                    <% if (car.carCondition === 'DAMAGED') { %>
                      · <span style="color:rgb(var(--red))">Damaged</span>
                    <% } %>
                  </div>
                </td>
                <td data-label="Price"><span class="num" style="font-weight:600">₩<%= car.carPrice %></span></td>
                <td data-label="Stats">
                  <div class="t-secondary num" style="margin-top:0">
                    <%= car.carViewCount %> views · <%= car.carLikeCount %> likes
                  </div>
                </td>
                <td data-label="Status">
                  <select class="status-select <%= car.carStatus === 'ONSALE' ? 's-green' : car.carStatus === 'RESERVED' ? 's-amber' : car.carStatus === 'SOLD' ? 's-blue' : 's-neutral' %>"
                          id="<%= car._id %>" onchange="updateCarStatus(this)">
                    <% CarStatus.map(function(status) { %>
                      <option value="<%= status %>" <%= car.carStatus === status ? 'selected' : '' %>>
                        <%= status.charAt(0) + status.slice(1).toLowerCase() %>
                      </option>
                    <% }) %>
                  </select>
                </td>
                <td data-label="Actions" class="t-right">
                  <div class="row-actions">
                    <button onclick="openEditCarModal(this)" class="icon-btn" title="Edit listing" aria-label="Edit listing">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    </button>
                    <% if (car.carStatus === 'SOLD') { %>
                    <button onclick="openSaleModalFromRow(this)" class="icon-btn is-success" title="Edit sale record" aria-label="Edit sale record">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </button>
                    <% } %>
                    <button onclick="deleteCar('<%= car._id %>')" class="icon-btn is-danger" title="Delete" aria-label="Delete">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% if(cars.length === 0) { %>
              <tr><td colspan="8" class="t-empty">No cars yet. Add your first listing above.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="card-foot"><span><%= cars.length %> total</span></div>
      </div>

      <!-- ---------- Sold ---------- -->
      <% var soldCars = cars.filter(function(c){ return c.carStatus === 'SOLD'; }); %>
      <div class="card">
        <div class="card-head">
          <h3 class="card-title">Sold</h3>
          <span class="hint"><%= soldCars.length %> recorded</span>
        </div>

        <div class="tbl-wrap scrollbar-hide">
          <table class="tbl">
            <thead>
              <tr>
                <th class="t-idx">#</th>
                <th>Vehicle</th>
                <th>VIN</th>
                <th>Buyer</th>
                <th>Sale date</th>
                <th class="t-right">Sale price</th>
                <th class="t-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% soldCars.map(function(car, key) { %>
              <tr data-car="<%= encodeURIComponent(JSON.stringify(car)) %>">
                <td data-label="#" class="t-idx num"><%= key + 1 %></td>
                <td data-label="Vehicle">
                  <div class="t-primary"><%= car.carTitle %></div>
                  <div class="t-secondary"><%= car.carBrand %> · <%= car.carYear %></div>
                </td>
                <td data-label="VIN" class="num" style="font-size:12.5px"><%= car.carVin || '—' %></td>
                <td data-label="Buyer"><%= car.buyerName || '—' %></td>
                <td data-label="Sale date" class="num" style="font-size:12.5px">
                  <%= car.saleDate ? new Date(car.saleDate).toISOString().slice(0,10) : '—' %>
                </td>
                <td data-label="Sale price" class="t-right num" style="font-weight:600; color:rgb(var(--green))">
                  <%= car.salePrice != null ? '₩' + car.salePrice.toLocaleString() : '—' %>
                </td>
                <td data-label="Actions" class="t-right">
                  <button onclick="openSaleModalFromRow(this)" class="btn btn-ghost btn-sm">Edit sale</button>
                </td>
              </tr>
              <% }) %>
              <% if(soldCars.length === 0) { %>
              <tr><td colspan="7" class="t-empty">No sales recorded yet. Mark a listing as Sold to record one.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</main>

<!-- ---------- Edit car ---------- -->
<div id="edit-car-modal" class="modal" hidden>
  <div class="modal-scrim" onclick="closeEditCarModal()"></div>
  <div class="modal-panel max-w-5xl">
    <div class="modal-head">
      <div>
        <h3 class="card-title">Edit listing</h3>
        <p class="hint">Update this vehicle's details</p>
      </div>
      <button type="button" onclick="closeEditCarModal()" class="icon-btn is-danger" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="edit-car-form" class="modal-body grid grid-cols-12 gap-6">
      <input type="hidden" name="_id" />

      <div class="col-span-12 md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="field sm:col-span-2">
          <label>Listing title *</label>
          <input name="carTitle" type="text" required class="input" />
        </div>

        <div class="field sm:col-span-2">
          <label>VIN</label>
          <input name="carVin" type="text" maxlength="17" class="input input-mono uppercase" />
        </div>

        <div class="field">
          <label>Brand *</label>
          <input name="carBrand" type="text" required list="brand-options" autocomplete="off" class="input" placeholder="Hyundai" />
        </div>

        <div class="field">
          <label>Model</label>
          <input name="carModel" type="text" class="input" />
        </div>

        <div class="field">
          <label>Body type *</label>
          <select name="carType" required class="select">
            <% CarType.map(function(t) { %>
              <option value="<%= t %>"><%= t.charAt(0) + t.slice(1).toLowerCase() %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="edit-car-condition">Condition *</label>
          <select id="edit-car-condition" name="carCondition" required class="select">
            <% CarCondition.map(function(c) { %>
              <option value="<%= c %>"><%= c.charAt(0) + c.slice(1).toLowerCase() %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label>Status *</label>
          <select name="carStatus" required class="select">
            <% CarStatus.map(function(status) { %>
              <option value="<%= status %>"><%= status.charAt(0) + status.slice(1).toLowerCase() %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label>Model year *</label>
          <input name="carYear" type="text" required class="input input-mono" placeholder="2024 or 2025/12" />
        </div>

        <div class="field">
          <label>Mileage (km) *</label>
          <input name="carMileage" type="number" required min="0" class="input input-mono" />
        </div>

        <div class="field">
          <label>Valuation (KRW) *</label>
          <input name="carPrice" type="text" required data-usd-estimate-source class="input input-mono"
                 placeholder="18,000,000 or 18,000,000~22,000,000" />
          <p data-usd-estimate class="hint">Estimated USD: enter a KRW price</p>
        </div>

        <div class="field">
          <label>Colour</label>
          <input name="carColor" type="text" list="color-options" autocomplete="off" class="input" placeholder="White" />
        </div>

        <div class="field">
          <label>Fuel</label>
          <select name="carFuel" class="select">
            <% CarFuel.map(function(f) { %>
              <option value="<%= f %>"><%= f.charAt(0) + f.slice(1).toLowerCase() %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label>Transmission</label>
          <select name="carTransmission" class="select">
            <% CarTransmission.map(function(t) { %>
              <option value="<%= t %>"><%= t.charAt(0) + t.slice(1).toLowerCase() %></option>
            <% }) %>
          </select>
        </div>

        <div class="field sm:col-span-2">
          <label>Description and notes</label>
          <textarea name="carDesc" rows="3" class="textarea"></textarea>
        </div>

        <!-- Shown only while the status is Sold; cleared by the server otherwise. -->
        <div id="edit-sale-fields" class="sm:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-5" hidden>
          <div class="field">
            <label>Buyer name</label>
            <input name="buyerName" type="text" class="input" />
          </div>
          <div class="field">
            <label>Sale price (KRW)</label>
            <input name="salePrice" type="number" min="0" class="input input-mono" />
          </div>
          <div class="field">
            <label>Sale date</label>
            <input name="saleDate" type="date" class="input input-mono" />
          </div>
        </div>
      </div>

      <div class="col-span-12 md:col-span-4">
        <div class="field">
          <label>Current gallery</label>
          <div id="edit-car-images" class="grid grid-cols-2 gap-2"></div>
          <p class="hint mt-2">This form edits listing information only. Photos are set when the car is created.</p>
        </div>
      </div>

      <div class="col-span-12 form-actions">
        <button type="button" onclick="closeEditCarModal()" class="btn btn-ghost">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </div>
</div>

<!-- ---------- Record sale ---------- -->
<div id="sale-modal" class="modal" hidden>
  <div class="modal-scrim" onclick="closeSaleModal()"></div>
  <div class="modal-panel max-w-md">
    <div class="modal-head">
      <div>
        <h3 class="card-title">Record sale</h3>
        <p class="hint">Mark this vehicle as sold</p>
      </div>
      <button type="button" onclick="closeSaleModal()" class="icon-btn is-danger" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="sale-form" class="modal-body flex flex-col gap-5">
      <input type="hidden" name="_id" />
      <p id="sale-car-title" class="t-primary"></p>

      <div class="field">
        <label>VIN *</label>
        <input name="carVin" type="text" maxlength="17" required class="input input-mono uppercase"
               placeholder="1HGCM82633A004352" />
        <p class="hint">Buyers can verify this sale publicly using the VIN.</p>
      </div>

      <div class="field">
        <label>Buyer name *</label>
        <input name="buyerName" type="text" required class="input" placeholder="John Doe" />
      </div>

      <div class="field">
        <label>Sale price (KRW) *</label>
        <input name="salePrice" type="number" min="0" required class="input input-mono" placeholder="18000000" />
      </div>

      <div class="field">
        <label>Sale date *</label>
        <input name="saleDate" type="date" required class="input input-mono" />
      </div>

      <div class="form-actions">
        <button type="button" onclick="closeSaleModal()" class="btn btn-ghost">Cancel</button>
        <button type="submit" class="btn btn-success">Confirm sale</button>
      </div>
    </form>
  </div>
</div>

<datalist id="brand-options">
  <% CarBrand.map(function(brand) { %><option value="<%= brand %>"></option><% }) %>
</datalist>
<datalist id="color-options">
  <% CarColor.map(function(color) { %><option value="<%= color %>"></option><% }) %>
</datalist>

<script src="/js/cars.js"></script>
</body>
<%- include('includes/footer') %>
