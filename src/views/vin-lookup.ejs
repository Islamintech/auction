<%- include('includes/header') %>

<body>
<main style="padding-top:0">
  <div style="max-width:600px; margin:0 auto; padding:48px 16px 64px">

    <div class="flex items-center justify-center gap-2.5" style="margin-bottom:28px">
      <img src="/img/logo.png" alt="" style="width:30px; height:30px; object-fit:contain" class="dark:invert" />
      <span class="brand-name" style="font-size:17px">AutoAuction</span>
    </div>

    <div class="card">
      <div class="card-body">
        <h1 style="font-size:20px; font-weight:650; letter-spacing:-0.02em">Verify a sale by VIN</h1>
        <p class="page-sub" style="margin-bottom:20px">Enter a vehicle's VIN to confirm its sale record.</p>

        <form action="/vin" method="GET" class="field">
          <label for="vin">Vehicle identification number</label>
          <div class="flex flex-col sm:flex-row gap-2.5">
            <input id="vin" name="vin" type="text" maxlength="17" required value="<%= vin %>"
                   class="input input-mono uppercase" placeholder="1HGCM82633A004352" />
            <button type="submit" class="btn btn-primary">Check</button>
          </div>
        </form>
      </div>
    </div>

    <% if (searched) { %>
      <% if (car && car.carStatus === 'SOLD') { %>
        <div class="card" style="margin-top:20px">
          <div class="card-head">
            <h3 class="card-title">Sold vehicle</h3>
            <span class="tag tag-green"><span class="dot"></span> Verified</span>
          </div>

          <div class="card-body flex flex-col gap-5">
            <div>
              <div class="label">Vehicle</div>
              <div class="t-primary" style="font-size:16px; margin-top:2px"><%= car.carTitle %></div>
              <div class="t-secondary"><%= car.carBrand %> · <%= car.carYear %></div>
            </div>

            <% var imgs = Array.isArray(car.carImages) ? car.carImages : []; %>
            <% if (imgs.length) { %>
            <div>
              <div class="label">Photos</div>
              <div class="grid grid-cols-4 gap-2" style="margin-top:6px">
                <% imgs.forEach(function(image, i){ %>
                  <button type="button" onclick="openGallery(<%= i %>)" class="thumb aspect-square"
                          style="border:1px solid rgb(var(--border)); cursor:pointer; padding:0">
                    <img src="<%= imgUrl(image) %>" alt="" />
                  </button>
                <% }) %>
              </div>
            </div>
            <% } %>

            <div class="grid grid-cols-2 gap-5">
              <div>
                <div class="label">VIN</div>
                <div class="num" style="font-size:13px; word-break:break-all"><%= car.carVin %></div>
              </div>
              <div>
                <div class="label">Buyer</div>
                <div style="font-size:13.5px"><%= car.buyerName || '—' %></div>
              </div>
              <div>
                <div class="label">Sale price</div>
                <div class="num" style="font-weight:600; color:rgb(var(--green))">
                  <%= car.salePrice != null ? '₩' + car.salePrice.toLocaleString() : '—' %>
                </div>
              </div>
              <div>
                <div class="label">Sale date</div>
                <div class="num" style="font-size:13px">
                  <%= car.saleDate ? new Date(car.saleDate).toISOString().slice(0,10) : '—' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } else if (car) { %>
        <div class="card" style="margin-top:20px">
          <div class="card-body" style="text-align:center">
            <p>A vehicle with this VIN exists but has <strong>not been sold</strong>.</p>
          </div>
        </div>
      <% } else { %>
        <div class="card" style="margin-top:20px">
          <div class="card-body" style="text-align:center; color:rgb(var(--text-muted))">
            <p>No vehicle found for VIN <span class="num">“<%= vin %>”</span>.</p>
          </div>
        </div>
      <% } %>
    <% } %>

  </div>
</main>

<% var galleryImgs = (searched && car && car.carStatus === 'SOLD' && Array.isArray(car.carImages)) ? car.carImages : []; %>
<% if (galleryImgs.length) { %>
<div id="gallery-lightbox" class="modal" hidden>
  <div class="modal-scrim" style="background:rgb(2 6 23 / .92)"></div>

  <button type="button" onclick="closeGallery()" aria-label="Close"
    style="position:absolute; top:18px; right:20px; z-index:2; width:38px; height:38px; border-radius:99px; border:0; cursor:pointer; background:rgb(255 255 255 / .12); color:#fff; font-size:22px; line-height:1">&times;</button>

  <button type="button" onclick="slideGallery(-1)" aria-label="Previous"
    style="position:absolute; left:16px; top:50%; transform:translateY(-50%); z-index:2; width:44px; height:44px; border-radius:99px; border:0; cursor:pointer; background:rgb(255 255 255 / .12); color:#fff; font-size:24px; line-height:1">&#8249;</button>

  <div style="position:relative; height:100%; display:flex; align-items:center; justify-content:center; padding:0 72px">
    <img id="gallery-image" src="" alt="Vehicle photo"
         style="max-width:100%; max-height:80vh; object-fit:contain; border-radius:12px" />
  </div>

  <button type="button" onclick="slideGallery(1)" aria-label="Next"
    style="position:absolute; right:16px; top:50%; transform:translateY(-50%); z-index:2; width:44px; height:44px; border-radius:99px; border:0; cursor:pointer; background:rgb(255 255 255 / .12); color:#fff; font-size:24px; line-height:1">&#8250;</button>

  <div id="gallery-counter" class="num"
       style="position:absolute; bottom:22px; left:50%; transform:translateX(-50%); color:rgb(255 255 255 / .75); font-size:12.5px"></div>
</div>

<script>
  const GALLERY_IMAGES = <%- JSON.stringify(galleryImgs) %>;
  let galleryIndex = 0;

  function renderGallery() {
    const img = document.getElementById('gallery-image');
    const counter = document.getElementById('gallery-counter');
    if (!GALLERY_IMAGES.length) return;
    const src = GALLERY_IMAGES[galleryIndex];
    img.src = /^https?:\/\//.test(src) ? src : '/' + src;
    counter.textContent = (galleryIndex + 1) + ' / ' + GALLERY_IMAGES.length;
  }

  function openGallery(i) {
    galleryIndex = i || 0;
    renderGallery();
    document.getElementById('gallery-lightbox').hidden = false;
  }

  function closeGallery() {
    document.getElementById('gallery-lightbox').hidden = true;
  }

  function slideGallery(step) {
    const n = GALLERY_IMAGES.length;
    galleryIndex = (galleryIndex + step + n) % n;
    renderGallery();
  }

  document.addEventListener('keydown', (e) => {
    const box = document.getElementById('gallery-lightbox');
    if (!box || box.hidden) return;
    if (e.key === 'ArrowRight') slideGallery(1);
    else if (e.key === 'ArrowLeft') slideGallery(-1);
    else if (e.key === 'Escape') closeGallery();
  });

  // Clicking the dark backdrop (not the image or arrows) closes the lightbox.
  document.querySelector('#gallery-lightbox .modal-scrim').addEventListener('click', closeGallery);
</script>
<% } %>

</body>
<%- include('includes/footer') %>
