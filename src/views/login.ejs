<%- include('includes/header') %>

<body>
<main style="padding-top:0; display:flex; align-items:center; justify-content:center; padding-left:16px; padding-right:16px">
  <div style="width:100%; max-width:400px; padding:48px 0">

    <div class="flex items-center justify-center gap-2.5" style="margin-bottom:28px">
      <img src="/img/logo.png" alt="" style="width:30px; height:30px; object-fit:contain" class="dark:invert" />
      <span class="brand-name" style="font-size:17px">AutoAuction</span>
    </div>

    <div class="card">
      <div class="card-body">
        <h1 style="font-size:20px; font-weight:650; letter-spacing:-0.02em">Sign in</h1>
        <p class="page-sub" style="margin-bottom:22px">Admin access only.</p>

        <form action="/admin/login" method="POST" class="flex flex-col gap-4">
          <div class="field">
            <label for="memberNick">Username</label>
            <input id="memberNick" name="memberNick" type="text" required autocomplete="username"
                   class="input" placeholder="Your admin username" />
          </div>

          <div class="field">
            <label for="memberPassword">Password</label>
            <div style="position:relative">
              <input id="memberPassword" name="memberPassword" type="password" required
                     autocomplete="current-password" class="input" style="padding-right:40px" placeholder="••••••••" />
              <button type="button" onclick="togglePassword()" aria-label="Show password"
                      class="icon-btn" style="position:absolute; right:4px; top:50%; transform:translateY(-50%)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" style="width:100%; margin-top:4px">Sign in</button>
        </form>
      </div>

      <div class="card-foot" style="justify-content:center; gap:16px">
        <a href="/admin/signup" style="color:rgb(var(--accent))">Create an account</a>
        <span style="color:rgb(var(--border))">·</span>
        <a href="/admin">Back to overview</a>
      </div>
    </div>

    <p class="hint" style="text-align:center; margin-top:20px">© 2026 autoauction.kr</p>
  </div>
</main>

<script>
  function togglePassword() {
    const input = document.getElementById('memberPassword');
    input.type = input.type === 'password' ? 'text' : 'password';
  }
</script>

</body>
<%- include('includes/footer') %>
